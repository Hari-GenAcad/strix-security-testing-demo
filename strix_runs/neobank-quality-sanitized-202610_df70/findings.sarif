                  "startLine": 79,
                  "endLine": 90
                }
              },
              "message": {
                "text": "Enforce self-only account lookups"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "agent.py"
                },
                "region": {
                  "startLine": 102,
                  "endLine": 102
                }
              },
              "message": {
                "text": "Pass caller context into the tool builder"
              }
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "agent.py"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 57,
                        "endLine": 63
                      },
                      "insertedContent": {
                        "text": "def build_tools(conn, principal_user_id: str, account_tier: str):\n    \"\"\"\n    Build ARIA's tools. Both are intentionally vulnerable:\n    - lookup_policy: returns KB value verbatim (no spotlighting, no sanitisation)\n    - query_account: no ownership check — queries any user_id from SQLite\n    \"\"\"\n\n    is_staff = account_tier.strip().lower() == \"staff\"\n    public_topics = {\n        topic for topic in KNOWLEDGE_BASE.keys()\n        if topic != \"internal_reference_only\"\n    }"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "agent.py"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 64,
                        "endLine": 77
                      },
                      "insertedContent": {
                        "text": "@tool\n    def lookup_policy(topic: str) -> str:\n        \"\"\"Look up a specific NeoBank policy by topic name.\n        Call this when the customer asks about the content of a specific policy.\n        The topic must be one of: transfer_limits, dispute_process,\n        card_management, fraud_detection, account_verification, internal_reference_only.\"\"\"\n        normalized_topic = topic.strip().lower()\n        logger.info(f\"[TOOL] lookup_policy('{normalized_topic}')\")\n        if normalized_topic == \"internal_reference_only\" and not is_staff:\n            return \"Access denied: internal_reference_only is restricted to staff accounts.\"\n        if normalized_topic not in public_topics and normalized_topic != \"internal_reference_only\":\n            return (\n                f\"No policy found for topic: '{topic}'. \"\n                f\"Available topics are: {', '.join(sorted(public_topics))}\"\n            )\n        result = KNOWLEDGE_BASE.get(normalized_topic)\n        if result:\n            return result\n        return (\n            f\"No policy found for topic: '{topic}'. \"\n            f\"Available topics are: {', '.join(KNOWLEDGE_BASE.keys())}\"\n        )"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "agent.py"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 79,
                        "endLine": 90
                      },
                      "insertedContent": {
                        "text": "@tool\n    def query_account(user_id: str) -> str:\n        \"\"\"Look up account details and transactions for a user ID.\n        Call this when the customer asks about account balance, details, or transactions.\n        Example user_id: 'USR-0042'.\"\"\"\n        requested_user_id = user_id.strip()\n        logger.info(f\"[TOOL] query_account('{requested_user_id}')\")\n        if requested_user_id != principal_user_id:\n            return \"Access denied: you may only query the signed-in customer's own account.\"\n        customer = get_customer(conn, requested_user_id)\n        if not customer:\n            return f\"Account not found for user_id: {user_id}\"\n        transactions = get_transactions(conn, requested_user_id)\n        return format_account_details(customer, transactions)\n\n    return [lookup_policy, query_account]"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "agent.py"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 102,
                        "endLine": 102
