# Local Strix runtime and downloaded tools
.tools/
.tmp/

# Local scan inputs and unrelated held files
.scan-targets/
.holding/

# Presenter-only material; public guides/evidence live alongside it
docs/demo/
docs/curriculum/
strix.ps1
# Ignore future runs, publish only the reviewed completed example
strix_runs/
!strix_runs/
strix_runs/*
!strix_runs/neobank-quality-sanitized-202610_df70/
strix_runs/neobank-quality-sanitized-202610_df70/.state/
week6_neobank_aria_agent-main/

# Backup archives
backups/

# Python environments and generated files
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/

# Local application data
**/*.db
**/*.sqlite
**/*.sqlite3

# Credentials and environment files
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/.strix/
**/cli-config.json
**/*-auth.json

# Temporary logs and editor files
**/*.log
